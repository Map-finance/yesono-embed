{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yesono-embed",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "dev": {
      "name": "dev-yesono-embed"
    }
  }
}
