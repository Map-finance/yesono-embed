# ==================== 环境配置 ====================
# 嵌入项目只做展示，不需要登录/交易/钱包相关 env。
# 默认 dev 走 next dev；部署用 .env.production。

NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ==================== API 配置 ====================
# 业务 API 根地址（用于 favorite/holdings-rank/comments 等只读接口）
NEXT_PUBLIC_C2C_API_BASE_URL=https://xb69.me
# 后端域名根地址（不带 /api；代码会自行拼接 /api）
NEXT_PUBLIC_AUTH_API_URL=https://c.qf318.com
# Legacy h2 后端：详情页「我的持仓 / 当前委托 / 成交历史 / 成交明细」读接口走这里。
# TOB 后端的对应能力上线后，把 hooks 内的 LEGACY_ROUTER_BASE_URL 改回 ROUTER_BASE_URL 即可。
NEXT_PUBLIC_LEGACY_ROUTER_BASE_URL=https://c.qf318.com/router
# 评论翻译/AI 审核（marketService 用于市场图片审核接口；不用可留空）
NEXT_PUBLIC_REVIEW_API_HOST=https://review.yesono.trade

# ==================== 区块浏览器（可选，仅 explorer 跳转链接显示用） ====================
NEXT_PUBLIC_EXPLORER_BASE_URL=https://ploutos.bacscan.net

# ==================== 图片代理（避免 X-Frame / 403 跨域问题） ====================
NEXT_PUBLIC_IMAGE_PROXY_BASE_URL=/i
NEXT_PUBLIC_ENABLE_IMAGE_PROXY=true
NEXT_PUBLIC_IMAGE_PROXY_ALLOWED_HOSTS=polymarket-upload.s3.us-east-2.amazonaws.com,cryptologos.cc,img.logo.dev,cdn.jsdelivr.net,images.unsplash.com,picsum.photos,via.placeholder.com,robohash.org,c.qf318.com,dev-api.yesono.trade

# ==================== WebSocket（订单簿 / Live Price 实时行情） ====================
NEXT_PUBLIC_ORDERBOOK_WS_URL=wss://ploutos-bundler.bitassetchain.io/ws

# ==================== iframe 嵌入安全 ====================
# 默认 *（任意域可嵌）；上线请收紧到具体宿主域名，多个用空格分隔。
# 例: NEXT_PUBLIC_EMBED_FRAME_ANCESTORS="https://host1.example.com https://host2.example.com"
NEXT_PUBLIC_EMBED_FRAME_ANCESTORS=*

# ==================== 交易参数 ====================
# 市价单滑点保护(基点;500=5%)。同步保护价/资金预留;TOB orderPrice 由此派生
NEXT_PUBLIC_MARKET_SLIPPAGE_BPS=500
# 交易 taker 手续费率(按类目 slug 的 JSON,值 ∈ [0,1])。不设则用内置默认表:
#   crypto 0.07 · sports 0.03 · finance/politics/tech/mentions 0.04 · economics/culture/weather 0.05 · geopolitics 0 · other 0.05
# 仅覆盖需要改的类目即可,如:{"crypto":0.05,"sports":0.02}。公式 fee = 份额 × feeRate × p × (1-p)
# NEXT_PUBLIC_MARKET_FEE_RATES={}
